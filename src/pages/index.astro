---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { AREAS } from '../data/areas';
import { getPublishedPosts } from '../lib/posts';

const latest = (await getPublishedPosts()).slice(0, 3);

const steps = [
  { title: 'Diagnostic', body: 'A free check of the area you pick, walked through on a discovery call.' },
  { title: 'Workshop', body: 'A half-day working session that turns the findings into a written plan.' },
  { title: 'Implementation', body: 'We work the plan with you for a set number of months.' },
  { title: 'Check-ins', body: 'Optional. Every two weeks, so the work keeps moving.' },
];
---

<BaseLayout
  title="Web Strategy and Analytics for the AI Era"
  description="Web analytics and web strategy for the AI era, right-sized to your team. Start with a free diagnostic and a discovery call."
>
  <section class="hero hero--solo">
    <div class="wrap">
      <h1>Web strategy and analytics <span class="accent">for the AI era.</span></h1>
      <p class="lead">
        We help busy teams make their sites easier to find and their data easier
        to trust, with a plan sized to the team you actually have.
      </p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href="/contact">Book a discovery call →</a>
        <a class="btn btn-ghost btn-lg" href="/services">See services</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="areas-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="areas-heading">Pick where to start</h2>
      </div>
      <div class="area-grid">
        {
          AREAS.map((area) => (
            <article class="card">
              <span class="diagnostic">{area.diagnostic}</span>
              <h3>{area.name}</h3>
              <p>{area.problem}</p>
              <p class="card-cta">
                <a class="btn btn-ghost" href={`/${area.slug}`}>Explore {area.name} →</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band-paper" aria-labelledby="how-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="how-heading">How it works</h2>
      </div>
      <ol class="steps" style="list-style:none;padding:0;margin:0;">
        {
          steps.map((s, i) => (
            <li class="step">
              <div class="num">0{i + 1}</div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="center-link">
        Have something custom in mind? <a href="/contact?type=custom">Send a proposal →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prose">
        <h2>Hi, I'm Colleen.</h2>
        <p>
          I've spent ten years in analytics across financial services, B2B SaaS,
          media, and federal government, and trained over 500 non-technical
          professionals to use their own data with confidence. What I've
          learned: right-sized beats sophisticated, every time.
        </p>
        <p><a href="/about">More about me →</a></p>
      </div>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="section band-paper">
        <div class="wrap">
          <div class="section-head">
            <h2>Latest from Resources</h2>
          </div>
          <div class="prose">
            <PostList posts={latest} />
            <p class="center-link"><a href="/resources/">All resources →</a></p>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
