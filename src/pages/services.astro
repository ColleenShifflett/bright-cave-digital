---
import BaseLayout from '../layouts/BaseLayout.astro';
import StageCard from '../components/StageCard.astro';
import { STAGES } from '../data/stages';
---

<BaseLayout
  title="Services"
  description="Six stages of web strategy and analytics. Start where you are, stop when you're ready, and choose how hands-on to be."
>
  <section class="page-head">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h1 class="h2-size">We'll meet you where you are.</h1>
        <p class="sub">
          Every engagement is a stage, and each one is complete on its own.
          Start at the one that fits, stop when you're ready, or keep going. At
          every stage you choose how hands-on to be: do it yourself with our
          guides and templates, do it with us through coaching and working
          sessions, or have us do it.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="card-grid">
        {
          STAGES.map((s) => (
            <StageCard
              name={s.name}
              line={s.line}
              href={`/services/${s.slug}`}
              availability={s.availability}
            />
          ))
        }
      </div>

      <div class="prose" style="margin-top: var(--bca-space-16);">
        <h2>Add-ons, available at any stage</h2>
        <ul>
          <li>
            Content-first redesign oversight: we own the inventory, structure,
            labels, governance, and measurement plan while your designer or
            developer builds.
          </li>
          <li>Martech vendor selection.</li>
        </ul>

        <h2>Availability</h2>
        <p>
          Diagnose and Roadmap are open now. Foundation, Content, Optimize, and
          Enable run on a waiting list.
          <a href="/work-with-us">See availability →</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
