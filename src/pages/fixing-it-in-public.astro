---
import BaseLayout from '../layouts/BaseLayout.astro';
// Add a row to `history` after each rescan. No markup changes needed.
import progress from '../data/scorecard-progress.json';
---

<BaseLayout
  title="Fixing It in Public"
  description="I ran my own scorecard on my own site. Here's my score, what I'm changing, and what happens next."
>
  <section class="page-head">
    <div class="wrap">
      <article class="prose">
        <p class="eyebrow">Fixing it in public</p>
        <h1>Fixing it in public</h1>
        <p class="lead-text">
          Before I ran my scorecard on anyone else's site, I ran it on mine. It
          scored a 77: great with AI, thin on substance. The technical setup was
          solid. The content wasn't there yet. This page tracks what I change
          and what happens, one rescan at a time.
        </p>

        <h2>Score history</h2>
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr><th scope="col">Date</th><th scope="col">Score</th><th scope="col">What changed</th></tr>
            </thead>
            <tbody>
              {
                progress.history.map((row) => (
                  <tr><td>{row.date}</td><td>{row.score}</td><td>{row.change}</td></tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <h2>The numbers that matter</h2>
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr><th scope="col">Metric</th><th scope="col">Baseline</th><th scope="col">Latest</th></tr>
            </thead>
            <tbody>
              {
                progress.metrics.map((m) => (
                  <tr><th scope="row">{m.name}</th><td>{m.baseline}</td><td>{m.latest}</td></tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <h2>What I'm working on now</h2>
        <p>{progress.currentFocus}</p>
      </article>
    </div>
  </section>
</BaseLayout>
