---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="Sorry, that page doesn't exist."
  noindex={true}
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="gem gem--glow" aria-hidden="true" style="margin: 0 auto var(--bca-space-5);"></span>
        <p class="eyebrow">Error 404</p>
        <h2>That page doesn't exist.</h2>
        <p class="sub">
          It may have moved, or the link might be broken.
        </p>
        <div class="actions" style="justify-content:center;display:flex;gap:14px;flex-wrap:wrap;margin-top:var(--bca-space-8);">
          <a class="btn btn-primary" href="/">← Back to the homepage</a>
          <a class="btn btn-ghost" href="/services">See services</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
