---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const resources = (
  await getCollection('resources', ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const comingSoon = ['[Roadmap template]', '[Content model template]', '[DIY scorecard checklist]'];
---

<BaseLayout
  title="Free Resources"
  description="Guides and templates for teams who want to do it themselves."
>
  <section class="page-head">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Resources</p>
        <h1 class="h2-size">Do it yourself</h1>
        <p class="sub">
          Not everyone needs a consultant. These are the same guides and
          templates I use, free for anyone who wants to run with them.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <ul class="post-list card-grid" style="list-style:none;">
        <li>
          <article class="card">
            <span class="badge">guide · template</span>
            <h2>Tracking Governance Guide and Template</h2>
            <p>
              A practical guide to naming, tagging, and documenting your
              analytics, with a ready-to-use spreadsheet template.
            </p>
            <p class="card-cta">Link: [resource URL]</p>
          </article>
        </li>
        {
          resources.map((resource) => (
            <li>
              <article class="card">
                <span class="badge">{resource.data.resourceType}{resource.data.tier ? ` · ${resource.data.tier}` : ''}</span>
                <h2><a href={`/resources/${resource.id}/`}>{resource.data.title}</a></h2>
                <p>{resource.data.description}</p>
                <p class="card-cta"><a href={`/resources/${resource.id}/`}>Open →</a></p>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="prose" style="margin-top: var(--bca-space-16);">
        <h2>Coming soon</h2>
        <ul>
          {comingSoon.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
