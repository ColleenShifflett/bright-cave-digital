---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Resources"
  description="Field notes on web analytics, web strategy, and AI strategy from Bright Cave Digital."
>
  <section class="page-head">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Resources</p>
        <h1 class="h2-size">Field notes and guides</h1>
        <p class="sub">What we're learning about web analytics, web strategy, and AI, written for busy teams.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap" style="max-width: 820px;">
      <TagFilter />
      {posts.length === 0 && <p style="text-align:center;color:var(--bca-fg-muted);">No posts yet. Check back soon.</p>}
      <PostList posts={posts} />
    </div>
  </section>
</BaseLayout>
