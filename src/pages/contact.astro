---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Bright Cave Digital. Tell us your goal and how we can help — freelance work, a project consultation, or something else."
>
  <section class="page-head">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Contact</p>
        <h2>Tell us where you're headed.</h2>
        <p class="sub">
          Share your goal and how we can help — we'll point you to the right
          next step.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <LeadForm type="contact" submitLabel="Send message →" />
    </div>
  </section>

</BaseLayout>
