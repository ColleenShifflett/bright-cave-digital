---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
---

<BaseLayout
  title="Contact"
  description="Request a free scorecard, see what's open now, or send me a note about anything else."
>
  <section class="page-head">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Contact</p>
        <h1 class="h2-size">Get in touch</h1>
        <p class="sub">
          Want to see how your site scores?
          <a href="/scorecard">Request a free scorecard.</a> Interested in
          working together? <a href="/work-with-me">See what's open now.</a>
          For anything else, use the form below.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <LeadForm type="contact" submitLabel="Send message →" />
    </div>
  </section>
</BaseLayout>
