---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { DIAGNOSTICS_PER_WEEK } from '../consts';
---

<BaseLayout
  title="Book a Discovery Call"
  description="Request a free diagnostic, send a custom project proposal, or join the freelance waitlist."
  callCta={false}
>
  <section class="page-head">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Contact</p>
        <h1 class="h2-size">Book a discovery call</h1>
        <p class="sub">
          Tell us what you're looking for and we'll usually reply within two
          business days. Diagnostics are limited to {DIAGNOSTICS_PER_WEEK} a week, first
          come, first served.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <LeadForm type="contact" submitLabel="Send →" />
    </div>
  </section>
</BaseLayout>
