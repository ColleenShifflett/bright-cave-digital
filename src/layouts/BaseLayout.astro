---
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import Analytics from '../components/Analytics.astro';
import ScorecardCTA from '../components/ScorecardCTA.astro';
import { organizationSchema } from '../lib/jsonld';
import { SITE_TITLE, SITE_URL, SITE_TAGLINE, NAV_LINKS, FOOTER_LINKS } from '../consts';
import '../styles/tokens.css';
import '../styles/app.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  /** Extra schema.org objects to embed (e.g. Article schema). */
  schema?: Record<string, unknown>[];
  /**
   * Every page ends with the scorecard call to action. Set false on the
   * scorecard page itself, or on a page that renders its own ScorecardCTA.
   */
  scorecardCta?: boolean;
}

const { schema = [], scorecardCta = true, ...seo } = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', SITE_URL)}
    />
    <meta name="generator" content={Astro.generator} />

    <SEO {...seo} />

    <!-- Organization structured data (sitewide) -->
    <JsonLd schema={organizationSchema()} />
    <!-- Page-specific structured data (e.g. Article) -->
    {schema.map((s) => <JsonLd schema={s} />)}

    <!-- Analytics (GA4 via Partytown) -->
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <nav class="nav-top" aria-label="Primary">
          <a href="/" class="brand" aria-label={`${SITE_TITLE} home`}>
            <img class="mark" src="/brand/logo-mark-64.png" alt="" width="55" height="32" />
            <span class="wordmark">
              Bright Cave
              <span class="sub">Digital</span>
            </span>
          </a>
          <ul class="nav-links">
            {
              NAV_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="nav-cta">
            <a class="btn btn-primary" href="/scorecard">Get your scorecard</a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
      {scorecardCta && <ScorecardCTA />}
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div class="col">
            <a href="/" class="brand" aria-label={`${SITE_TITLE} home`}>
              <img class="mark" src="/brand/logo-mark-64.png" alt="" width="55" height="32" />
              <span class="wordmark">Bright Cave<span class="sub">Digital</span></span>
            </a>
            <p class="blurb">{SITE_TAGLINE}</p>
          </div>
          <div class="col col-wide">
            <h2>Explore</h2>
            <div class="link-cols">
              {FOOTER_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          </div>
          <div class="col">
            <h2>Follow</h2>
            <a href="/rss.xml">RSS feed</a>
            <a href="/sitemap-index.xml">Sitemap</a>
          </div>
        </div>
        <div class="legal">
          <span>&copy; {year} {SITE_TITLE}. All rights reserved.</span>
          <span>Made with care</span>
        </div>
      </div>
    </footer>
  </body>
</html>
